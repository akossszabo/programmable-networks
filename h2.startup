#!/bin/bash
# h2.startup - Host 2 (VLAN 20 - Guest Segment)

set -e  # Exit on error

echo "[h2] Configuring network interface..."
ip addr add 10.0.20.20/24 dev eth0
ip link set dev eth0 address 02:00:00:00:00:02

# Add routes to reach other VLAN subnets
echo "[h2] Adding routes to other VLANs..."
ip route add 10.0.10.0/24 dev eth0
ip route add 10.0.30.0/24 dev eth0

# STATIC ARP: Bypass ARP since our switch only reads IP/VLAN tags
echo "[h2] Configuring static ARP..."
arp -s 10.0.10.10 02:00:00:00:00:01
arp -s 10.0.30.30 02:00:00:00:00:03

echo "[h2] Host 2 initialization completed"
echo "[h2] IP: 10.0.20.20/24 (VLAN 20 - Guest Segment)"