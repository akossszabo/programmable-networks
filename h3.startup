#!/bin/bash
# h3.startup - Host 3 (VLAN 30 - Server/Services Segment)

set -e  # Exit on error

echo "[h3] Configuring network interface..."
ip addr add 10.0.30.30/24 dev eth0
ip link set dev eth0 address 02:00:00:00:00:03

# Add routes to reach other VLAN subnets
echo "[h3] Adding routes to other VLANs..."
ip route add 10.0.10.0/24 dev eth0
ip route add 10.0.20.0/24 dev eth0

# STATIC ARP: Bypass ARP since our switch only reads IP/VLAN tags
echo "[h3] Configuring static ARP..."
arp -s 10.0.10.10 02:00:00:00:00:01
arp -s 10.0.20.20 02:00:00:00:00:02

echo "[h3] Host 3 initialization completed"
echo "[h3] IP: 10.0.30.30/24 (VLAN 30 - Server/Services Segment)"